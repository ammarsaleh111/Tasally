# Netlify _headers file — force correct MIME types for Next.js static assets
# This takes priority over netlify.toml [[headers]] for files served from CDN

/_next/static/chunks/*.js
  Content-Type: application/javascript; charset=utf-8

/_next/static/chunks/*.css
  Content-Type: text/css; charset=utf-8

/_next/static/css/*.css
  Content-Type: text/css; charset=utf-8

/_next/static/*.js
  Content-Type: application/javascript; charset=utf-8

/_next/static/media/*.woff2
  Content-Type: font/woff2

/_next/static/media/*.woff
  Content-Type: font/woff

/sw.js
  Content-Type: application/javascript; charset=utf-8

/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
