# Tasally Environment Variables
# Copy this file to .env.local for local development.
# Never commit .env.local or real credentials to version control.

# ==========================================
# DATABASE (REQUIRED AT RUNTIME, SERVER-ONLY)
# ==========================================

# Direct Neon PostgreSQL connection string (used for Drizzle migrations & fallback)
# Example: postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Pooled Neon PostgreSQL connection string (used for serverless runtime queries)
# Example: postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=

# ==========================================
# AUTHENTICATION (REQUIRED AT RUNTIME, SERVER-ONLY)
# ==========================================

# NextAuth session encryption secret (minimum 32 random chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# Canonical NextAuth callback URL
# Local: http://localhost:3000 | Production: https://tasally.tech
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (optional for guest/email play, required for Google Sign-In)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==========================================
# ADMIN AUTHENTICATION (REQUIRED FOR /admin IN PRODUCTION, SERVER-ONLY)
# ==========================================

# Dedicated admin username (avoid default "admin" in production)
ADMIN_USERNAME=

# Strong admin password (minimum 12 chars)
ADMIN_PASSWORD=

# Admin HMAC signing secret (minimum 32 random chars)
ADMIN_SECRET=

# ==========================================
# SITE & DEPLOYMENT URLS (BUILD-TIME & RUNTIME)
# ==========================================

# Public site URL (used for metadata, canonicals, sitemap) - PUBLIC
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side site URL fallback - SERVER-ONLY
SITE_URL=http://localhost:3000

# Optional canonical redirect (set ENFORCE_CANONICAL_REDIRECT=true only after TLS & DNS verification)
ENFORCE_CANONICAL_REDIRECT=false
NEXT_PUBLIC_CANONICAL_HOST=
NEXT_PUBLIC_CANONICAL_PROTOCOL=https

# Node.js runtime version for Netlify
NODE_VERSION=22

# ==========================================
# OPTIONAL INTEGRATIONS
# ==========================================

# Wordnik API Key (optional; local dictionary is used when absent) - SERVER-ONLY
WORDNIK_API_KEY=

# Optional SEO verification tokens - PUBLIC
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_SITE_VERIFICATION=

# Optional build/version & debug flags - PUBLIC
NEXT_PUBLIC_APP_VERSION=
NEXT_PUBLIC_DEBUG_STARTUP=false
