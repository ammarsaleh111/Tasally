{
  "name": "tasally",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate-env": "node -e \"require('./src/utils/envValidation.js').logEnvironmentStatus()\"",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:setup": "node scripts/migrate.js",
    "test:api": "tsx scripts/api-smoke.ts",
    "generate:puzzles": "node scripts/generate-puzzles.mjs",
    "validate:puzzles": "tsx scripts/validate-puzzles.ts",
    "test:puzzles": "tsx --test tests/daily-data.test.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "an-array-of-english-words": "^2.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^12.29.2",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "postgres": "^3.4.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "wordlist-english": "^1.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1"
  }
}
